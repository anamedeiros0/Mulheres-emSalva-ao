# Não mostra a lista de arquivos de uma pasta
Options -Indexes

# Ninguém consegue abrir estes arquivos pelo navegador
<FilesMatch "^(config\.php|.*\.sql|\.env.*|\.gitignore.*|.*\.bat|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
</IfModule>